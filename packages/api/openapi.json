              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Household"
                }
              }
            }
          }
        }
      }
    },
    "/households": {
      "post": {
        "tags": [
          "households"
